NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cakracrm_db?schema=public

# Minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Opsional - jika kosong, JWT_SECRET dipakai (dengan audience berbeda)
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Origin frontend yang diizinkan CORS (pisahkan dengan koma untuk lebih dari satu)
CLIENT_URL=http://localhost:5173

# Opsional: lax | strict | none (default: none di production, lax di development)
# COOKIE_SAMESITE=
# COOKIE_DOMAIN=

# Akun ADMIN pertama dibuat otomatis saat server start jika tabel users masih kosong
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@jendelacakra.id
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Str0ng!
